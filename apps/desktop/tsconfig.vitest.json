{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        /* Vitest callers run on Node 22+, including Promise.withResolvers. */
        "lib": ["ES2022", "ES2024.Promise", "DOM", "DOM.Iterable"],
        "types": ["vitest/globals", "node"]
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.d.ts",
        "src/**/*.tsx",
        "src/**/*.vue",
        "scripts/**/*.d.ts",
        "scripts/**/*.d.mts",
        "tests/**/*.ts",
        "tests/**/*.d.ts"
    ]
}
